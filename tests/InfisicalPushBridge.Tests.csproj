<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- TUnit。テストプロジェクト自体が実行ファイル(Microsoft.Testing.Platform)なので
         Microsoft.NET.Test.Sdk も VSTest ランナーも要らない。dotnet run で走る -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.66.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../src/InfisicalPushBridge.csproj" />
  </ItemGroup>
</Project>
